# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# uploaded expense receipts — tenant data, written at runtime by lib/storage.ts.
# Override the location with RECEIPT_STORAGE_DIR; if you do, ignore that instead.
.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
